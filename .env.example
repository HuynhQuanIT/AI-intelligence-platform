# Provider: mock | openai | gemini
LLM_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048

# USD per 1 million tokens.
# Set these according to the current price for your selected Gemini model.
# Leave 0 until you configure the actual rates.
GEMINI_INPUT_USD_PER_1M_TOKENS=0
GEMINI_OUTPUT_USD_PER_1M_TOKENS=0

# Embedding (chỉ hoạt động khi LLM_PROVIDER=gemini).
# EMBEDDING_DIM phải khớp với cột vector(768) trong database.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Truy xuất (hybrid). Giá trị mặc định đo với gemini-embedding-001, 768 chiều.
# MIN_TOP_SIMILARITY: nếu chunk giống nhất còn dưới ngưỡng này thì không lấy chunk nào (câu hỏi không liên quan).
# MIN_SIMILARITY: sàn cho từng chunk phụ; SEMANTIC_MARGIN loại chunk kém xa chunk tốt nhất.
# Hiệu chỉnh trên 12 câu hỏi; đo lại khi bộ tài liệu thay đổi nhiều.
MIN_TOP_SIMILARITY=0.67
MIN_SIMILARITY=0.60
SEMANTIC_MARGIN=0.12
# Khi vector không tìm thấy gì, kết quả chỉ khớp từ khóa phải đạt điểm này mới được giữ.
LEXICAL_ALONE_MIN_SCORE=1.0
# Chunk chỉ khớp từ khóa phải khớp ít nhất tỉ lệ này của từ khóa trong câu hỏi.
LEXICAL_MIN_SCORE=0.5
RRF_SEMANTIC_WEIGHT=1.0
RRF_LEXICAL_WEIGHT=0.5

# Số vòng gọi công cụ tối đa của Tool Agent mỗi câu hỏi.
AGENT_MAX_TOOL_ROUNDS=4

# ---------------------------------------------------------------------------
# Đăng nhập và phân quyền
# ---------------------------------------------------------------------------
# BẮT BUỘC: chuỗi ngẫu nhiên >= 32 ký tự. ai-service từ chối chạy nếu thiếu, quá ngắn hoặc còn giá trị mẫu.
# Tạo bằng PowerShell:  [Convert]::ToBase64String((1..48 | % { Get-Random -Maximum 256 }) -as [byte[]])
JWT_SECRET=change-me-generate-a-random-secret-of-32+chars
ACCESS_TOKEN_MINUTES=60
# Khóa bí mật thêm để băm OTP (để trống thì dùng JWT_SECRET).
OTP_PEPPER=

# Admin đầu tiên, tạo khi khởi động nếu chưa có (mật khẩu >= 10 ký tự). Không đổi mật khẩu tài khoản đã tồn tại.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Ai được tự đăng ký (luôn phải xác thực OTP qua email):
#   approval - đăng ký xong phải chờ admin duyệt (mặc định)
#   domain   - chỉ email thuộc ALLOWED_EMAIL_DOMAINS, dùng được ngay
#   open     - ai cũng dùng được ngay
#   closed   - tắt đăng ký
REGISTRATION_MODE=approval
ALLOWED_EMAIL_DOMAINS=
CHAT_RATE_LIMIT_PER_MIN=20
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# Gửi mã OTP. console: in mã vào log ai-service (chỉ để thử trên máy mình).
# smtp: gửi thật. Với Gmail: bật xác minh 2 bước, tạo "Mật khẩu ứng dụng" (App Password) rồi điền bên dưới.
# KHÔNG commit mật khẩu thật. Chạy thật nên dùng dịch vụ gửi mail chuyên dụng (Resend, SendGrid, Brevo, SES).
MAIL_BACKEND=console
MAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
