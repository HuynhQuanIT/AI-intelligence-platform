# Provider: mock | openai | gemini
LLM_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048

# USD per 1 million tokens.
# Set these according to the current price for your selected Gemini model.
# Leave 0 until you configure the actual rates.
GEMINI_INPUT_USD_PER_1M_TOKENS=0
GEMINI_OUTPUT_USD_PER_1M_TOKENS=0

# Embedding (chỉ hoạt động khi LLM_PROVIDER=gemini).
# EMBEDDING_DIM phải khớp với cột vector(768) trong database.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Truy xuất (hybrid). Giá trị mặc định đo với gemini-embedding-001, 768 chiều.
# MIN_TOP_SIMILARITY: nếu chunk giống nhất còn dưới ngưỡng này thì không lấy chunk nào (câu hỏi không liên quan).
# MIN_SIMILARITY: sàn cho từng chunk phụ; SEMANTIC_MARGIN loại chunk kém xa chunk tốt nhất.
# Hiệu chỉnh trên 12 câu hỏi; đo lại khi bộ tài liệu thay đổi nhiều.
MIN_TOP_SIMILARITY=0.67
MIN_SIMILARITY=0.60
SEMANTIC_MARGIN=0.12
# Khi vector không tìm thấy gì, kết quả chỉ khớp từ khóa phải đạt điểm này mới được giữ.
LEXICAL_ALONE_MIN_SCORE=1.0
# Chunk chỉ khớp từ khóa phải khớp ít nhất tỉ lệ này của từ khóa trong câu hỏi.
LEXICAL_MIN_SCORE=0.5
RRF_SEMANTIC_WEIGHT=1.0
RRF_LEXICAL_WEIGHT=0.5

# Số vòng gọi công cụ tối đa của Tool Agent mỗi câu hỏi.
AGENT_MAX_TOOL_ROUNDS=4
